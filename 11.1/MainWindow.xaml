<Window x:Class="PcPartsInventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Parts Inventory" Height="520" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="PartsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" TabIndex="0" IsTabStop="True" KeyboardNavigation.TabNavigation="None" GotKeyboardFocus="PartsGrid_GotKeyboardFocus" SelectionChanged="PartsGrid_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding PartId}" Width="35" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category.CategoryName}" Width="90" />
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="90" />
                <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="140" />
                <DataGridTextColumn Header="Specs" Binding="{Binding Specs}" Width="*" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="70" />
                <DataGridTextColumn Header="Stock" Binding="{Binding QuantityInStock}" Width="45" />
                <DataGridTextColumn Header="Year" Binding="{Binding ReleaseYear}" Width="45" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Part ID" />
            <TextBox x:Name="PartIDBox" TabIndex="1" Margin="0,0,0,6" />
            <TextBlock Text="Category" />
            <ComboBox x:Name="CategoryCombo" TabIndex="2" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" Margin="0,0,0,6" />
            <TextBlock Text="Manufacturer" />
            <TextBox x:Name="ManufacturerBox" TabIndex="3" Margin="0,0,0,6" />
            <TextBlock Text="Model Name" />
            <TextBox x:Name="ModelBox" TabIndex="4" Margin="0,0,0,6" />
            <TextBlock Text="Specs" />
            <TextBox x:Name="SpecsBox" TabIndex="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6" />
            <TextBlock Text="Price" />
            <TextBox x:Name="PriceBox" TabIndex="6" Margin="0,0,0,6" />
            <TextBlock Text="Quantity" />
            <TextBox x:Name="QuantityBox" TabIndex="7" Margin="0,0,0,6" />
            <TextBlock Text="Release Year" />
            <TextBox x:Name="YearBox" TabIndex="8" Margin="0,0,0,10" />

            <UniformGrid Columns="2" Margin="0,0,0,6">
                <Button Content="Add" TabIndex="9" Click="AddButton_Click" Margin="0,0,3,3" Padding="4" />
                <Button Content="Update" TabIndex="10" Click="UpdateButton_Click" Margin="3,0,0,3" Padding="4" />
                <Button Content="Delete" TabIndex="11" Click="DeleteButton_Click" Margin="0,3,3,0" Padding="4" />
                <Button Content="Clear" TabIndex="12" Click="ClearButton_Click" Margin="3,3,0,0" Padding="4" />
            </UniformGrid>
            <Button Content="Restore Defaults" TabIndex="13" Click="RestoreButton_Click" Margin="0,0,0,6" Padding="4" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="DarkSlateGray" />
        </StackPanel>
    </Grid>
</Window>
